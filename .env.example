# Variáveis de ambiente da loja (na Hostinger: app Node.js → Variáveis de ambiente).
# Só estas são necessárias. TODO o resto (Mercado Pago, frete, e-mails, Google, WhatsApp...)
# é configurado em  Painel /admin → ⚙️ Configurações.

NODE_ENV=production

# Senha do PRIMEIRO acesso ao painel. Depois de entrar, troque em Configurações → Senha do painel
# (a partir daí esta variável deixa de valer).
ADMIN_PASSWORD=troque-esta-senha

# Pasta do banco de dados, fotos e backups — FORA da pasta do app, para não perder nada ao atualizar.
# Ex.: /home/u123456789/dfr3d-dados
DATA_DIR=./data

# Banco MySQL (recomendado na Hostinger). Se DB_NAME e DB_USER estiverem preenchidos, a loja usa o MySQL;
# senão, usa um arquivo SQLite dentro de DATA_DIR. Na 1ª vez com MySQL vazio, os dados do SQLite são copiados sozinhos.
# NUNCA coloque a senha real neste arquivo: preencha só nas Variáveis de ambiente da Hostinger.
# DB_HOST=127.0.0.1     (na Hostinger: 127.0.0.1 ou localhost; de fora: srv1781.hstgr.io com "MySQL remoto" liberado)
# DB_PORT=3306
# DB_NAME=u000000000_nome
# DB_USER=u000000000_usuario
# DB_PASSWORD=

# Opcionais:
# PORT=3000            (a Hostinger define sozinha; não precisa)
# SESSION_SECRET=...   (se vazio, a loja gera um e guarda no banco)
#
# Qualquer campo da página Configurações também pode vir daqui com o mesmo nome
# (ex.: BASE_URL, MP_ACCESS_TOKEN...). O valor salvo no painel tem prioridade.
