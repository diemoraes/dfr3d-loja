# Copie este arquivo para ".env" e preencha. Na Hostinger, cadastre as mesmas
# variáveis em "Variáveis de ambiente" do app Node.js. Só as 4 primeiras seções
# são obrigatórias; o resto liga recursos opcionais.

# ========== 1. Básico (obrigatório) ==========
BASE_URL=https://dfr3d.com.br
PORT=3000
NODE_ENV=production
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-texto-aleatorio-com-mais-de-32-caracteres
# Pasta do banco, fotos e backups. Na Hostinger, use uma pasta FORA da pasta do app.
DATA_DIR=./data

# Captcha do login do painel. Vazio = captcha próprio (imagem com letras).
# Opcional: Cloudflare Turnstile (grátis) → dash.cloudflare.com → Turnstile → Adicionar site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ========== 2. Identificação da loja ==========
LOJA_NOME=DFR 3D Impressão
LOJA_RESPONSAVEL=Diego de Oliveira Moraes
# Localização exibida no rodapé, nos e-mails e na página /politicas
LOJA_CIDADE=São José dos Campos - SP

# ========== 3. Contato e retirada ==========
WHATSAPP=5512981020949
EMAIL_CONTATO=contato@dfr3d.com.br
INSTAGRAM=dfr.3d
RETIRADA_ATIVA=true
RETIRADA_ENDERECO=São José dos Campos - SP (endereço enviado após a confirmação)

# ========== 4. Mercado Pago ==========
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Desconto (%) para quem paga no Pix. 0 = sem desconto
PIX_DESCONTO=5
# Pedido não pago é cancelado (e o estoque liberado) depois de X horas
PEDIDO_EXPIRA_HORAS=72

# ========== 5. Frete — Melhor Envio ==========
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_EMAIL=contato@dfr3d.com.br
# IDs dos serviços aceitos (vazio = todos). Ex.: 1,2 (PAC e SEDEX)
MELHOR_ENVIO_SERVICOS=
CEP_ORIGEM=12200000
# Frete fixo em reais (usado se o Melhor Envio não estiver configurado)
FRETE_FIXO=
# Frete grátis acima deste valor em reais (vazio = desligado)
FRETE_GRATIS_ACIMA=

# Remetente impresso na etiqueta (necessário para gerar etiquetas pelo painel)
REMETENTE_NOME=DFR 3D Impressão
REMETENTE_TELEFONE=
REMETENTE_EMAIL=
# CPF ou CNPJ de quem envia (exigido pelo Melhor Envio; só vai na etiqueta, não aparece no site)
REMETENTE_DOCUMENTO=
REMETENTE_RUA=
REMETENTE_NUMERO=
REMETENTE_COMPLEMENTO=
REMETENTE_BAIRRO=
REMETENTE_CIDADE=São José dos Campos
REMETENTE_UF=SP

# ========== 6. E-mails automáticos (escolha UM: Resend ou Brevo) ==========
RESEND_API_KEY=
BREVO_API_KEY=
# Remetente verificado no serviço escolhido
EMAIL_REMETENTE=DFR 3D <pedidos@dfr3d.com.br>
# Para onde vão os avisos de novos pedidos (se vazio, usa EMAIL_CONTATO)
EMAIL_ADMIN=

# ========== 7. Aviso no celular quando um pedido é pago ==========
# Telegram: crie um bot com o @BotFather e pegue seu chat_id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via CallMeBot (grátis): veja callmebot.com/blog/free-api-whatsapp-messages
CALLMEBOT_TELEFONE=
CALLMEBOT_APIKEY=

# ========== 8. Medição de visitas (só carrega se o visitante aceitar cookies) ==========
GA_ID=
META_PIXEL_ID=

# ========== 9. Backup ==========
BACKUP_MANTER_DIAS=14
# true = manda o backup diário do banco para o EMAIL_ADMIN
BACKUP_POR_EMAIL=false

# ========== 10. Login de clientes com Google ==========
# console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: https://SEU-DOMINIO/api/conta/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========== 11. Mercado Livre (sincronizar estoque) ==========
ML_CLIENT_ID=
ML_CLIENT_SECRET=
